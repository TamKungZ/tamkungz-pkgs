---
import type { MavenArtifact } from "../lib/maven-catalog";

interface Props {
  artifacts: MavenArtifact[];
  repoUrl: string;
}

const { artifacts, repoUrl } = Astro.props;
const selected = artifacts[0];
const dependency = selected ? `${selected.groupId}:${selected.artifactId}:${selected.version}` : "";
---

{
  artifacts.length > 0 && (
    <section class="install maven-install" aria-label="Maven dependency">
      <div class="maven-select-row">
        <label for="maven-artifact">Choose an artifact</label>
        <select id="maven-artifact" class="filter maven-select">
          {artifacts.map((artifact, index) => (
            <option
              value={`${artifact.groupId}:${artifact.artifactId}:${artifact.version}`}
              data-source={artifact.sourceUrl ?? ""}
              selected={index === 0}
            >
              {artifact.name} ({artifact.artifactId})
            </option>
          ))}
        </select>
        <a
          class="source-link maven-source"
          href={selected?.sourceUrl}
          aria-label={`GitHub source for ${selected?.name}`}
          title="GitHub source"
          target="_blank"
          rel="noopener noreferrer"
          hidden={!selected?.sourceUrl}
        >
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
            <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.23.49-2.7-.95-2.7-.95-.36-.93-.9-1.18-.9-1.18-.73-.5.06-.49.06-.49.8.06 1.22.82 1.22.82.71 1.21 1.86.86 2.32.66.07-.52.28-.86.5-1.06-1.78-.2-3.65-.89-3.65-3.96 0-.88.31-1.6.82-2.17-.08-.2-.36-1.03.08-2.14 0 0 .67-.22 2.2.83A7.65 7.65 0 0 1 8 4.46c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.83 2.2-.83.44 1.11.16 1.94.08 2.14.51.57.82 1.29.82 2.17 0 3.08-1.87 3.76-3.66 3.96.29.25.54.73.54 1.47v2.17c0 .21.15.46.55.38A8 8 0 0 0 8 0Z" />
          </svg>
        </a>
      </div>
      <div class="code-block">
        <div class="code-head">
          <div class="code-title">
            <span class="code-lang">groovy</span>
            <span class="code-label">Gradle dependency</span>
          </div>
          <button class="btn maven-copy" type="button">Copy</button>
        </div>
        <pre><code class="language-groovy" data-repo-url={repoUrl}>{`repositories {
    maven {
        name = "TamKungZ Maven"
        url = uri("${repoUrl}")
    }
}

dependencies {
    implementation("${dependency}")
}`}</code></pre>
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>(".maven-install").forEach((root) => {
    const select = root.querySelector<HTMLSelectElement>("#maven-artifact");
    const code = root.querySelector<HTMLElement>(".code-block code");
    const source = root.querySelector<HTMLAnchorElement>(".maven-source");
    const button = root.querySelector<HTMLButtonElement>(".maven-copy");

    select?.addEventListener("change", () => {
      const option = select.selectedOptions[0];
      const repoUrl = code?.dataset.repoUrl;
      if (!code || !repoUrl) return;
      code.textContent = `repositories {\n    maven {\n        name = "TamKungZ Maven"\n        url = uri("${repoUrl}")\n    }\n}\n\ndependencies {\n    implementation("${option.value}")\n}`;
      if (source) {
        const sourceUrl = option.dataset.source;
        source.hidden = !sourceUrl;
        if (sourceUrl) {
          source.href = sourceUrl;
          source.setAttribute("aria-label", `GitHub source for ${option.textContent?.trim() ?? "selected artifact"}`);
        }
      }
    });

    button?.addEventListener("click", async () => {
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        button.textContent = "Copied";
        button.classList.add("done");
      } catch {
        button.textContent = "Failed";
        button.classList.add("failed");
      }
      setTimeout(() => {
        button.textContent = "Copy";
        button.classList.remove("done", "failed");
      }, 1400);
    });
  });
</script>
