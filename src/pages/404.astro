---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import { AUTHOR, SITE } from "../config/site";

const title = `${SITE.name} - Page not found`;
const description = "The page, package, or artifact may have moved, been removed, or the URL may be incorrect.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={SITE.faviconSvg} type="image/svg+xml" />
    <link rel="icon" href={SITE.faviconIco} sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="topbar">
      <div class="wrap topbar-in">
        <a class="brand" href="/">
          <img src={SITE.faviconSvg} alt="" width="24" height="24" />
          <span>{SITE.name}</span>
        </a>
        <a class="nav-ext" href={AUTHOR.githubUrl}>GitHub</a>
      </div>
    </div>

    <main class="wrap error-main" id="content">
      <section class="error-page" aria-labelledby="error-title">
        <svg
          class="error-icon"
          viewBox="0 0 400 330"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          focusable="false"
          stroke-linejoin="round"
          stroke-linecap="round"
        >
          <ellipse cx="200" cy="312" rx="104" ry="9" fill="currentColor" opacity=".12" />
          <path d="M110 190 200 230V310L110 270Z" fill="currentColor" opacity=".9" />
          <path d="M200 230 290 190V270L200 310Z" fill="currentColor" opacity=".6" />
          <path d="M200 150 290 190 200 230 110 190Z" fill="currentColor" fill-opacity=".14" stroke="currentColor" stroke-width="4" />
          <path d="M130 226 164 242" stroke="#fff" stroke-opacity=".7" stroke-width="5" />
          <path d="M200 20 240 42V88L200 110 160 88V42Z" stroke="currentColor" stroke-width="4" stroke-dasharray="3 10" />
          <path d="M187 60C187 46 213 46 213 60 213 69 200 71 200 80" stroke="currentColor" stroke-width="5" />
          <circle cx="200" cy="93" r="3.5" fill="currentColor" stroke="none" />
          <rect x="70" y="92" width="14" height="14" rx="3" fill="currentColor" opacity=".35" transform="rotate(18 77 99)" />
          <rect x="318" y="118" width="10" height="10" rx="2" fill="currentColor" opacity=".25" transform="rotate(-14 323 123)" />
          <circle cx="320" cy="60" r="5" fill="currentColor" opacity=".3" />
          <circle cx="86" cy="222" r="4" fill="currentColor" opacity=".25" />
        </svg>

        <p class="error-code" aria-hidden="true">404</p>
        <h1 id="error-title">Page not found</h1>
        <p class="error-description">{description}</p>
        <p id="error-path" class="error-path" hidden></p>

        <div class="error-actions">
          <a class="btn-primary" href="/">Return to Packages</a>
          <a href="mailto:dev@tamkungz.me?subject=Broken%20link%20on%20TamKungZ_%20Packages">Report a broken link</a>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const pathElement = document.querySelector<HTMLElement>("#error-path");
      const path = window.location.pathname;

      if (pathElement && path && path !== "/") {
        pathElement.textContent = path;
        pathElement.hidden = false;
      }
    </script>
  </body>
</html>

<style>
  .error-main {
    display: grid;
    flex: 1;
    min-height: 360px;
    place-items: center;
    padding-block: 28px 40px;
  }

  .error-page {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .error-icon {
    display: block;
    width: min(280px, 75%);
    height: auto;
    margin: 0 auto 8px;
    color: var(--accent-text);
  }

  .error-code {
    margin: 0;
    color: var(--accent-text);
    font-size: 5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .error-page h1 {
    margin: 4px 0 8px;
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .error-description {
    margin: 0 auto 20px;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .error-path {
    display: inline-block;
    max-width: 100%;
    margin: 0 0 24px;
    padding: 8px 14px;
    overflow-wrap: anywhere;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 13px;
  }

  .error-path[hidden] { display: none; }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 20px;
  }

  .btn-primary {
    display: inline-block;
    padding: 10px 24px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: #fff;
    font-weight: 600;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    color: #fff;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .error-main { min-height: 320px; }
    .error-code { font-size: 4rem; }
    .error-page h1 { font-size: 1.5rem; }
  }
</style>
